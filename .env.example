# AutoDL developer token. Keep the real value only in .env.
AUTODL_TOKEN=

# AutoDL Pro instance defaults.
# v-48g = 4090-48G, according to AutoDL's Pro API docs.
AUTODL_GPU_SPEC_UUID=v-48g
AUTODL_GPU_AMOUNT=1
AUTODL_CUDA_V_FROM=118
AUTODL_SYSTEM_DISK_GB=0
AUTODL_INSTANCE_NAME=ERP Phase3 sanity

# Optional overrides for the data-prep instance.
# AutoDL Pro API does not support CPU-only creation: req_gpu_amount min is 1
# and gpu_spec_uuid is required. Pick the cheapest available GPU spec in the
# same region as your file storage. Do not reuse 4090 unless you intend to.
AUTODL_DATA_PREP_INSTANCE_NAME=ERP Phase3 data prep
AUTODL_DATA_PREP_GPU_SPEC_UUID=
AUTODL_DATA_PREP_GPU_AMOUNT=1
AUTODL_DATA_PREP_IMAGE_UUID=
AUTODL_DATA_PREP_DATA_CENTERS=beijingDC2

# Default public PyTorch CUDA 11.8 image from AutoDL docs.
# Replace this with your private image UUID after you save a warmed-up image.
AUTODL_IMAGE_UUID=base-image-l2t43iu6uk

# Optional region list, comma-separated. For this project we pin Beijing B
# so the instance can mount the same AutoDL file storage at /root/autodl-fs.
AUTODL_DATA_CENTERS=beijingDC2

# Git repository reachable from the AutoDL instance.
# This should be this project repository, and it must contain the Phase3 scripts.
ERP_REPO_URL=https://github.com/songofhawk/ERP-Benchmark.git
ERP_REPO_DIR=/root/ERP-Benchmark

# Where CESCA-AODD lives on the AutoDL instance.
# AutoDL file storage is mounted at /root/autodl-fs inside instances.
# Expected layout: /root/autodl-fs/dataset/200Hz/CESCA-AODD/{Feature,Label}
PHASE3_DATA_ROOT=/root/autodl-fs/dataset/200Hz

# Optional: if CESCA-AODD is missing under PHASE3_DATA_ROOT, bootstrap can download data.
# This is the processed-datasets Google Drive folder linked by the project README/paper repo.
# Bootstrap downloads only CESCA-AODD from this folder.
PHASE3_DATA_ARCHIVE_URL=https://drive.google.com/drive/folders/1pVUmPlsQN9j5HD5YJSeiDrBAUAKBCQA5?usp=drive_link
PHASE3_DATA_ARCHIVE_NAME=cesca-aodd-200hz.tar.gz
PHASE3_DATA_EXTRACT_DIR=/root/autodl-fs
PHASE3_DATA_DOWNLOAD_ROOT=/root/autodl-fs/downloads_gdrive
# Keep GPU bootstrap from spending paid GPU time on data download.
PHASE3_ALLOW_BOOTSTRAP_DOWNLOAD=0

# Set to 1 only if the selected image has not already been prepared.
PHASE3_INSTALL_REQUIREMENTS=0
PHASE3_REQUIREMENTS_FILE=requirements-phase3-sanity.txt
PHASE3_BATCH_SIZE=128
PHASE3_DEVICES=0
CUDA_VISIBLE_DEVICES=0
